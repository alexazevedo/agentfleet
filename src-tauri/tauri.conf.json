{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentfleet",
  "version": "0.1.0",
  "identifier": "com.alexazevedo.agentfleet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "agentfleet",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCQTVFNzMxOEMyNzU4MTYKUldRV1dDZU1NZWVsUzRMK0x5UTJxSkRKVGJpRVVCV2xFZ2tCT2RGL1pYRVdVd2JIelJveUlaVUwK",
      "endpoints": ["https://github.com/alexazevedo/agentfleet/releases/latest/download/latest.json"]
    }
  }
}
